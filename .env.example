# Copy this file to .env and fill in your real values. .env is gitignored.

# Anthropic API key (required for the recommend node's LLM call)
ANTHROPIC_API_KEY=

# Model to use (optional; defaults to claude-sonnet-5)
# Options: claude-opus-5 (most capable) | claude-sonnet-5 | claude-haiku-4-5 (cheapest)
ANTHROPIC_MODEL=claude-sonnet-5

# Max agent steps / tool-call budget (optional)
AGENT_MAX_STEPS=12
